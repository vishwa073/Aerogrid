# ==========================================
# AeroGrid Environment Configuration Example
# ==========================================
# Copy this file to .env before running locally:
#   copy .env.example .env (Windows PowerShell)
#   cp .env.example .env   (Linux/macOS)

# -----------------
# Backend Settings
# -----------------
PROJECT_NAME="AeroGrid"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Allowed CORS origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Elexon Insights Solution REST API base URL
ELEXON_API_BASE_URL="https://data.elexon.co.uk/bmrs/api/v1"
ELEXON_HTTP_TIMEOUT_SECONDS=30

# Forecast Decision Cutoff Rule (Assumption to be verified / configured)
# Formatted as HH:MM in UTC (defaulting to 11:00 UTC day-ahead auction cutoff)
DEFAULT_DECISION_CUTOFF_TIME="11:00"

# -----------------
# Database (PostgreSQL)
# -----------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aerogrid_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=aerogrid_db
# Optional full connection URL (overrides individual credentials if provided)
# DATABASE_URL=postgresql+asyncpg://aerogrid_user:your_secure_password_here@localhost:5432/aerogrid_db

# -----------------
# Frontend Settings
# -----------------
VITE_API_BASE_URL="http://localhost:8000"
VITE_APP_TITLE="AeroGrid | Wind Forecast Intelligence"
